{
  "name": "git-time-machine",
  "private": true,
  "version": "0.7.0",
  "type": "module",
  "description": "Reconstruct scope-aware, functional development history from project archives — fully in the browser.",
  "scripts": {
    "dev": "vite",
    "prepare:libarchive": "node scripts/copy-libarchive-assets.mjs",
    "postinstall": "npm run prepare:libarchive",
    "build": "npm run prepare:libarchive && tsc --noEmit && vite build",
    "preview": "vite preview",
    "test:core": "tsc -p tsconfig.core.json && node scripts/core-smoke.mjs"
  },
  "dependencies": {
    "jszip": "^3.10.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "libarchive.js": "^2.0.2"
  },
  "devDependencies": {
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "typescript": "^7.0.2",
    "vite": "^8.1.5"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
